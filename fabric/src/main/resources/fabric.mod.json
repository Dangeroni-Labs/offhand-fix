{
	"schemaVersion": 1,
	"id": "offhand_fix",
	"version": "${version}",
	"name": "Kossman's Offhand Fix",
	"description": "Improves offhand stack handling by refilling compatible stacks during shift-click and swap-hand interactions.",
	"authors": ["Dangeroni Labs"],
	"contact": {
		"sources": "https://github.com/Dangeroni-Labs/offhand-fix",
		"issues": "https://github.com/Dangeroni-Labs/offhand-fix/issues"
	},
	"license": "MIT",
	"icon": "assets/offhand_fix/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.dangeroni.offhandfix.OffhandFixMod"],
		"modmenu": ["dev.dangeroni.offhandfix.client.OffhandFixModMenu"]
	},
	"mixins": [
		"offhand_fix.mixins.json",
		{
			"config": "offhand_fix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": { "modmenu": ">=7.2.0 <8.0.0" }
}
